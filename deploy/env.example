# /etc/ocapps/env - configuration of the ocapps unified service (SPEC §9.2).
#
#   install -d -m 750 -o root -g ocapps /etc/ocapps
#   install -m 640 -o root -g ocapps deploy/env.example /etc/ocapps/env
#   $EDITOR /etc/ocapps/env
#
# Precedence (SPEC §3.1): OCAPPS_* > legacy variable > default.
# The legacy variables of the three old services are still read for
# 2 minor versions (up to 0.3.0) with a warning on every start. They are
# listed next to each variable. The values below are generic EXAMPLES:
# adjust hosts, user and tokens to your instance.

# --- Shared -----------------------------------------------------------------

# OpenCloud server root (REQUIRED with OCAPPS_AUTH_MODE=opencloud).
# Legacy: OCNEWS_OPENCOLOUD_URL (historic typo with a double O), OCNOTES_GRAPH_URL
# (it carried the /graph/v1.0/me suffix, so the root is derived automatically),
# OC_BASE_URL.
OCAPPS_OPENCLOUD_URL=https://cloud.example.com

# Listen address of the SINGLE listener (the three old services had one port
# each, and now everything goes through a single one).
# Legacy: OCNEWS_ADDR / OCNOTES_ADDR / LISTEN_ADDR are only used to detect old
# deployments in the logs; the port is NOT inherited (SPEC §3.2).
# Default: 127.0.0.1:8077
# Change the port freely: it is the only thing the proxy needs to know. Inside
# a container keep 8077 and publish another host port in the port mapping.
OCAPPS_LISTEN_ADDR=127.0.0.1:8077

# Data root directory. The per-module subdirectories are derived:
# <dir>/news, <dir>/notes, <dir>/photos (SPEC §5.1). With the bundled systemd
# unit (StateDirectory=ocapps) it matches /var/lib/ocapps.
# Legacy: OCNEWS_DATA_DIR / OCNOTES_DATA_DIR / DATA_DIR. If a per-module legacy
# variable is defined, THAT path is used for that module (smooth transition).
# Default: /var/lib/ocapps
OCAPPS_DATA_DIR=/var/lib/ocapps

# Log level: debug|info|warn|error. Default: info.
# Legacy: OCNEWS_LOG_LEVEL.
OCAPPS_LOG_LEVEL=info

# Authentication mode: opencloud (Graph, recommended) | local (bcrypt,
# news only, bootstrap/dev). Note the default changes from `local` (ocnews) to
# `opencloud`. Default: opencloud.
# Legacy: OCNEWS_AUTH_MODE / OCNOTES_AUTH_MODE.
OCAPPS_AUTH_MODE=opencloud

# Turn a module off without uninstalling (true|false). No legacy equivalent.
# Defaults: true. Useful for instance to start without photos during the
# migration.
#OCAPPS_NEWS_ENABLED=true
#OCAPPS_NOTES_ENABLED=true
#OCAPPS_PHOTOS_ENABLED=true

# --- news (OCAPPS_NEWS_*) ---------------------------------------------------

# Public URL of the news API (WebSub callbacks). Empty = WebSub disabled.
# Legacy: OCNEWS_PUBLIC_URL. Default: "".
OCAPPS_NEWS_PUBLIC_URL=https://cloud.example.com/index.php/apps/news/api/v1-3

# Feed refresh interval. It must be > 0 and <= OCAPPS_NEWS_MAX_GAP.
# Legacy: OCNEWS_FEED_INTERVAL. Default: 15m.
#OCAPPS_NEWS_FEED_INTERVAL=15m

# Maximum gap between items before forcing a feed resync. >= FEED_INTERVAL.
# Legacy: OCNEWS_MAX_GAP. Default: 6h.
#OCAPPS_NEWS_MAX_GAP=6h

# HTTP timeout when downloading feeds. Legacy: OCNEWS_FETCH_TIMEOUT. Default: 20s.
#OCAPPS_NEWS_FETCH_TIMEOUT=20s

# Item retention in days, 0 = disabled.
# Legacy: OCNEWS_RETENTION_DAYS. Default: 90.
OCAPPS_NEWS_RETENTION_DAYS=90

# ntfy server for push notifications. Legacy: OCNEWS_NTFY_URL.
# Default: https://ntfy.sh
#OCAPPS_NEWS_NTFY_URL=https://ntfy.example.com

# ntfy topic (empty = notifications disabled). Legacy: OCNEWS_NTFY_TOPIC.
OCAPPS_NEWS_NTFY_TOPIC=

# Bootstrap admin credentials in `local` mode (unnecessary in opencloud mode).
# Legacy: AUTH_USER / AUTH_PASS (the generic unprefixed names disappear from
# the new schema). Defaults: "".
#OCAPPS_NEWS_AUTH_USER=
#OCAPPS_NEWS_AUTH_PASS=

# --- notes (OCAPPS_NOTES_*) -------------------------------------------------

# Owner for the backfill of the `user` column on empty rows (notes migration
# 002). Only needed if rows without an owner are left in the copied database.
# Legacy: OCNOTES_OWNER. Default: "".
OCAPPS_NOTES_OWNER=

# --- photos (OCAPPS_PHOTOS_*) -----------------------------------------------
# Photos is MULTI-TENANT (H8): any OpenCloud user comes in with their web
# session (OIDC Bearer) and gets their own index, albums and thumbnails
# scoped to their oc_id. There is NO mandatory user any more.

# Users with a periodic background scan (their photos get indexed even if they
# do not open the app): "alice:apptoken1,bob:apptoken2". The app tokens only
# live in memory (never on disk). A malformed entry means the module is failed
# (D3). Default: "".
#OCAPPS_PHOTOS_USERS=alice:<alice-app-token>

# Legacy pair (equivalent to listing that user in OCAPPS_PHOTOS_USERS, with a
# deprecation WARN). OPTIONAL since H8. They are also used for (a) the identity
# of the deprecated static Bearer and (b) the backfill of the single-tenant era
# index (see "Multi-user in photos" in deploy/README.md).
# Legacy: OC_USER / OC_APP_TOKEN. Default: "".
#OCAPPS_PHOTOS_USER=admin
#OCAPPS_PHOTOS_APP_TOKEN=<opencloud-app-token>

# DEPRECATED (H8): static Bearer for machine-to-machine clients. Only valid if
# OCAPPS_PHOTOS_USER is configured (it maps to its oc_id), and setting it
# without USER is a config error (module failed). Clients should migrate to the
# OpenCloud OIDC Bearer. Legacy: MEMORIES_TOKEN. Default: "".
OCAPPS_PHOTOS_TOKEN=

# Root folder of the photo scan (relative to the user's space).
# Legacy: SCAN_ROOT. Default: Fotos.
OCAPPS_PHOTOS_SCAN_ROOT=Fotos

# Re-scan interval. It must be > 0. Legacy: SCAN_EVERY. Default: 5m.
OCAPPS_PHOTOS_SCAN_EVERY=30m

# Root of the thumbnail cache. Default: <OCAPPS_DATA_DIR>/thumbs.
# With large libraries (thousands of photos, about 20-40 KB per thumbnail) it
# is worth pointing it at a volume with room instead of the container rootfs.
# If you move it out of OCAPPS_DATA_DIR, ADD that path to the unit's
# ReadWritePaths (the service runs with ProtectSystem=strict).
#OCAPPS_PHOTOS_CACHE_DIR=/var/lib/opencloud/ocapps-cache/thumbs

# WEB_DIR (ocphotos): REMOVED with the legacy PWA (SPEC §3.2, Q6). If it is
# still defined in the environment it is ignored with a warning, so delete it
# from your old env.

# --- Extensions panel (in-app, optional) ------------------------------------

# Token of the /ocapps-admin/ panel. If it is empty the panel is NOT published
# (it is not left open: the routes are simply not registered). It is sent in
# the X-Ocapps-Admin-Token header and grants install and update of extensions,
# so treat it as a root credential: whoever holds it can install code from the
# repos listed in extensions.conf.
# Generation: head -c 32 /dev/urandom | base64 | tr -d '\n=+/' | cut -c1-40
OCAPPS_ADMIN_TOKEN=

# Apps file the panel can manage (app|repo|asset regex).
# Default: /etc/ocapps/extensions.conf
OCAPPS_EXT_CONF=/etc/ocapps/extensions.conf

# Where the extensions are deployed. Default: /etc/opencloud/web/assets/apps
OCAPPS_EXT_APPS_DIR=/etc/opencloud/web/assets/apps

# Updater binary. Default: /usr/local/sbin/ocapps-ext
OCAPPS_EXT_HELPER=/usr/local/sbin/ocapps-ext
