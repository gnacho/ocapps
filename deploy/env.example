# /etc/ocapps/env — configuración del servicio unificado ocapps (SPEC §9.2).
#
#   install -d -m 750 -o root -g ocapps /etc/ocapps
#   install -m 640 -o root -g ocapps deploy/env.example /etc/ocapps/env
#   $EDITOR /etc/ocapps/env
#
# Precedencia (SPEC §3.1): OCAPPS_* > variable legacy > default.
# Las variables legacy de los tres servicios antiguos se siguen leyendo
# durante 2 versiones menores (hasta 0.3.0) con un warning por arranque;
# se indican junto a cada variable. Los valores de abajo son EJEMPLOS
# genéricos: ajusta hosts, usuario y tokens a tu instancia.

# --- Comunes ----------------------------------------------------------------

# Raíz del servidor OpenCloud (OBLIGATORIA con OCAPPS_AUTH_MODE=opencloud).
# Legacy: OCNEWS_OPENCOLOUD_URL (typo histórico con doble O), OCNOTES_GRAPH_URL
# (traía el sufijo /graph/v1.0/me: se deriva la raíz automáticamente),
# OC_BASE_URL.
OCAPPS_OPENCLOUD_URL=https://cloud.example.com

# Dirección de escucha del ÚNICO listener (los tres servicios viejos tenían
# cada uno su puerto; ahora todo va por uno solo).
# Legacy: OCNEWS_ADDR / OCNOTES_ADDR / LISTEN_ADDR solo se usan para detectar
# despliegues viejos en logs; NO se hereda el puerto (SPEC §3.2).
# Default: 127.0.0.1:8096
OCAPPS_LISTEN_ADDR=127.0.0.1:8096

# Directorio raíz de datos. Los subdirs por módulo se derivan:
# <dir>/news, <dir>/notes, <dir>/photos (SPEC §5.1). Con el unit systemd
# incluido (StateDirectory=ocapps) coincide con /var/lib/ocapps.
# Legacy: OCNEWS_DATA_DIR / OCNOTES_DATA_DIR / DATA_DIR — si una legacy por
# módulo está definida, ESA ruta se usa para ese módulo (transición suave).
# Default: /var/lib/ocapps
OCAPPS_DATA_DIR=/var/lib/ocapps

# Nivel de log: debug|info|warn|error. Default: info.
# Legacy: OCNEWS_LOG_LEVEL.
OCAPPS_LOG_LEVEL=info

# Modo de autenticación: opencloud (Graph, recomendado) | local (bcrypt,
# solo news; bootstrap/dev). Ojo: el default cambia de `local` (ocnews) a
# `opencloud`. Default: opencloud.
# Legacy: OCNEWS_AUTH_MODE / OCNOTES_AUTH_MODE.
OCAPPS_AUTH_MODE=opencloud

# Apagar un módulo sin desinstalar (true|false). Sin equivalente legacy.
# Defaults: true. Útil p. ej. para arrancar sin photos durante la migración.
#OCAPPS_NEWS_ENABLED=true
#OCAPPS_NOTES_ENABLED=true
#OCAPPS_PHOTOS_ENABLED=true

# --- news (OCAPPS_NEWS_*) ---------------------------------------------------

# URL pública del API de news (callbacks WebSub). Vacío = WebSub desactivado.
# Legacy: OCNEWS_PUBLIC_URL. Default: "".
OCAPPS_NEWS_PUBLIC_URL=https://cloud.example.com/index.php/apps/news/api/v1-3

# Intervalo de refresco de feeds. Debe ser > 0 y <= OCAPPS_NEWS_MAX_GAP.
# Legacy: OCNEWS_FEED_INTERVAL. Default: 15m.
#OCAPPS_NEWS_FEED_INTERVAL=15m

# Hueco máximo entre items antes de forzar resync del feed. >= FEED_INTERVAL.
# Legacy: OCNEWS_MAX_GAP. Default: 6h.
#OCAPPS_NEWS_MAX_GAP=6h

# Timeout HTTP al descargar feeds. Legacy: OCNEWS_FETCH_TIMEOUT. Default: 20s.
#OCAPPS_NEWS_FETCH_TIMEOUT=20s

# Retención de items en días; 0 = desactivada.
# Legacy: OCNEWS_RETENTION_DAYS. Default: 90.
OCAPPS_NEWS_RETENTION_DAYS=90

# Servidor ntfy para notificaciones push. Legacy: OCNEWS_NTFY_URL.
# Default: https://ntfy.sh
#OCAPPS_NEWS_NTFY_URL=https://ntfy.example.com

# Topic ntfy (vacío = notificaciones desactivadas). Legacy: OCNEWS_NTFY_TOPIC.
OCAPPS_NEWS_NTFY_TOPIC=

# Credenciales del admin de bootstrap en modo `local` (innecesarias en modo
# opencloud). Legacy: AUTH_USER / AUTH_PASS (las genéricas sin prefijo
# desaparecen del esquema nuevo). Defaults: "".
#OCAPPS_NEWS_AUTH_USER=
#OCAPPS_NEWS_AUTH_PASS=

# --- notes (OCAPPS_NOTES_*) -------------------------------------------------

# Owner para el backfill de la columna `user` en filas vacías (migración 002
# de notes). Solo necesario si quedan filas sin owner en la BD copiada.
# Legacy: OCNOTES_OWNER. Default: "".
OCAPPS_NOTES_OWNER=

# --- photos (OCAPPS_PHOTOS_*) -----------------------------------------------

# Usuario de OpenCloud dueño del app-token (photos es single-tenant).
# OBLIGATORIA si photos está enabled; si falta, el módulo photos arranca en
# estado failed (503) y news/notes siguen sirviendo (SPEC §3.3/D3).
# Legacy: OC_USER.
OCAPPS_PHOTOS_USER=admin

# App-token de OpenCloud del usuario anterior. OBLIGATORIA si photos enabled.
# Legacy: OC_APP_TOKEN.
OCAPPS_PHOTOS_APP_TOKEN=<app-token-de-opencloud>

# Bearer estático propio para clientes machine-to-machine (compat clientes
# viejos). Opcional; se comprueba ANTES de Graph. Renombrada: el nombre
# legacy MEMORIES_TOKEN era heredado y confuso. Legacy: MEMORIES_TOKEN.
# Default: "".
OCAPPS_PHOTOS_TOKEN=

# Carpeta raíz del escaneo de fotos (relativa al espacio del usuario).
# Legacy: SCAN_ROOT. Default: Fotos.
OCAPPS_PHOTOS_SCAN_ROOT=Fotos

# Intervalo de re-escaneo. Debe ser > 0. Legacy: SCAN_EVERY. Default: 5m.
OCAPPS_PHOTOS_SCAN_EVERY=30m

# WEB_DIR (ocphotos): ELIMINADA con la PWA legacy (SPEC §3.2, Q6). Si sigue
# definida en el entorno se ignora con un warning; bórrala de tu env viejo.
