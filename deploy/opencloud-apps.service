# opencloud-apps.service - single unit of the unified ocapps backend (SPEC §9.1).
#
# Installation:
#   install -m 644 deploy/opencloud-apps.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now opencloud-apps
#
# Requires: the `ocapps` user and group, and /etc/ocapps/env (see deploy/env.example).
[Unit]
Description=OpenCloud Apps (news+notes+photos unified backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocapps
Group=ocapps
EnvironmentFile=/etc/ocapps/env
ExecStart=/usr/local/bin/ocapps

# Restart=on-failure only acts if the WHOLE PROCESS dies. A failed module
# (for instance a corrupt photos database) restarts nothing: by design (D3,
# SPEC §4.5) the module stays failed, its namespace serves 503 and the other
# modules keep working. A restart would not fix the cause, and a restart loop
# would also take the healthy modules down. The operational signal of a failed
# module is `GET /readyz` -> 503 (plus the "module failed" log line), so
# monitor and alert on readyz, not on systemd restarts.
Restart=on-failure
RestartSec=5s

# /var/lib/ocapps created and managed by systemd (0700, owned by ocapps).
StateDirectory=ocapps
StateDirectoryMode=0700

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ocapps
PrivateTmp=true

[Install]
WantedBy=multi-user.target
