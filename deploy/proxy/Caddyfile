# Caddy snippet for the proxy in front of ocapps (SPEC §9.3).
# Equivalent to deploy/proxy/nginx.conf: include it inside the site block
# that serves the OpenCloud instance (same origin as the web app).
#
# ═══════════════════════════════════════════════════════════════════════
# ⚠  THE PROXY CHANGE OF THIS MIGRATION: /ocphotos-api/ WITHOUT STRIP
#
# Before, the proxy stripped /ocphotos-api/ (ocphotos saw `/api/...`).
# In the unified binary `/api/` belongs to news and photos registers its
# routes as `/ocphotos-api/api/...`, so the proxy must pass the prefix
# INTACT (in Caddy, `reverse_proxy` rewrites nothing by default, it is
# enough NOT to use `handle_path` or `uri strip_prefix`).
# ═══════════════════════════════════════════════════════════════════════

# Single upstream of the unified service (a single listener, SPEC §3.2).
# Caddy preserves Host and every request header by default (including
# Authorization, which carries the Basic/Bearer credentials), and adds
# X-Forwarded-For/Proto automatically.

# news: News API v1.3 contract plus the /api/me|users API of its own (the
# extension calls it at the host root, so exact patterns, NOT a /api/
# catch-all).
handle /index.php/apps/news/* {
	reverse_proxy 127.0.0.1:8077
}
handle /api/me {
	reverse_proxy 127.0.0.1:8077
}
handle /api/me/* {
	reverse_proxy 127.0.0.1:8077
}
handle /api/users {
	reverse_proxy 127.0.0.1:8077
}
handle /api/users/* {
	reverse_proxy 127.0.0.1:8077
}

# notes: Notes API contract plus OCS (capabilities and cloud/user are served
# by the notes module, SPEC §4.2).
handle /index.php/apps/notes/* {
	reverse_proxy 127.0.0.1:8077
}
handle /ocs/* {
	reverse_proxy 127.0.0.1:8077
}

# photos: /ocphotos-api/ WITHOUT STRIP (see the warning above). Do NOT use
# `handle_path` here, as it would drop the prefix and break the contract.
# Signed video streaming (/ocphotos-api/api/video/{id}): long timeouts for
# Range and streaming, and flush_interval -1 disables buffering.
handle /ocphotos-api/api/video/* {
	reverse_proxy 127.0.0.1:8077 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}
# Change notice channel (SSE): no buffering (flush_interval -1 is the Caddy
# default, left explicit) and long timeouts.
handle /ocphotos-api/api/stream {
	reverse_proxy 127.0.0.1:8077 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}
handle /ocphotos-api/* {
	reverse_proxy 127.0.0.1:8077
}
